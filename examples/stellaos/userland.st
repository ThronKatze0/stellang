        "        neg = t[0] == \"-\"",
        "        i = 1",
        "    }",
        "    var m = 0.0",
        "    var any = false",
        "    while i < n && t.byte(i) >= 48 && t.byte(i) <= 57 {",
        "        m = m * 10.0 + float(t.byte(i) - 48)",
        "        i += 1",
        "        any = true",
        "    }",
        "    var scale = 0",
        "    if i < n && t[i] == \".\" {",
        "        i += 1",
        "        while i < n && t.byte(i) >= 48 && t.byte(i) <= 57 {",
        "            m = m * 10.0 + float(t.byte(i) - 48)",
        "            scale -= 1",
        "            i += 1",
        "            any = true",
        "        }",
        "    }",
        "    if !any { return 0.0 }",
        "    if i < n && (t[i] == \"e\" || t[i] == \"E\") {",
        "        i += 1",
