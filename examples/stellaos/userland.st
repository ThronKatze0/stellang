        "    var n = abs(k)",
        "    while n > 0 {",
        "        if n % 2 == 1 { p = p * b }",
        "        b = b * b",
        "        n = n / 2",
        "    }",
        "    if k < 0 { return v / p }",
        "    return v * p",
        "}",
        "",
