        "    if code < 65536 {",
        "        let p = __str_new(3)",
        "        __st8(p + 8, 224 | (code >> 12))",
        "        __st8(p + 9, 128 | ((code >> 6) & 63))",
        "        __st8(p + 10, 128 | (code & 63))",
        "        return __str(p)",
        "    }",
        "    let p = __str_new(4)",
        "    __st8(p + 8, 240 | (code >> 18))",
        "    __st8(p + 9, 128 | ((code >> 12) & 63))",
        "    __st8(p + 10, 128 | ((code >> 6) & 63))",
        "    __st8(p + 11, 128 | (code & 63))",
        "    return __str(p)",
        "}",
        "",
        "fn user() -> str {",
        "    let b = __alloc(64)",
        "    let n = __syscall(19, b, 64)",
        "    let p = __str_new(n)",
        "    __copy(p + 8, b, n)",
        "    return __str(p)",
        "}",
        "",
        "// ---- files (yours: what your user may read and write) ----",
        "",
        "fn file_exists(path: str) -> bool {",
        "    return __syscall(15, __int(path) + 8, __ld(__int(path))) >= 0",
        "}",
        "",
        "// the file's text, or \"\" if it isn't there (or isn't yours to read)",
        "fn read_file(path: str) -> str {",
        "    let n = __syscall(15, __int(path) + 8, __ld(__int(path)))",
        "    if n <= 0 { return \"\" }",
        "    let p = __str_new(n)",
        "    let got = __syscall(16, p + 8, n)",
        "    __st(p, max(0, got))",
        "    return __str(p)",
        "}",
        "",
        "fn write_file(path: str, text: str) -> bool {",
        "    return __syscall(17, __int(path) + 8, __ld(__int(path)), __int(text) + 8, __ld(__int(text))) == 0",
        "}",
        "",
        "// ---- graphics: a window of your own ----",
        "",
        "fn window(w: int, h: int, title: str) { __syscall(6, w, h, __int(title) + 8, __ld(__int(title))) }",
        "fn rect(x: int, y: int, w: int, h: int, color: int) { __syscall(7, x, y, w, h, color) }",
        "fn clear(color: int) { __syscall(7, 0, 0, 4000, 4000, color) }",
        "fn circle(x: int, y: int, r: int, color: int) { __syscall(8, x, y, r, color) }",
        "fn line(x0: int, y0: int, x1: int, y1: int, color: int) { __syscall(9, x0, y0, x1, y1, color) }",
        "fn text(x: int, y: int, s: str, color: int) { __syscall(10, x, y, __int(s) + 8, __ld(__int(s)), color, 0) }",
        "fn big_text(x: int, y: int, s: str, color: int) { __syscall(10, x, y, __int(s) + 8, __ld(__int(s)), color, 1) }",
        "fn mono_text(x: int, y: int, s: str, color: int) { __syscall(10, x, y, __int(s) + 8, __ld(__int(s)), color, 2) }",
        "fn text_width(s: str) -> int { return __syscall(20, __int(s) + 8, __ld(__int(s)), 0) }",
        "fn show() { __syscall(11) }",
        "fn rgb(r: int, g: int, b: int) -> int { return (r & 255) << 16 | (g & 255) << 8 | (b & 255) }",
        "",
        "// the next key pressed in the window (\"\" if none): \"a\", \"A\", \"Enter\", \"ArrowLeft\", \" \", ...",
        "fn key() -> str {",
        "    if __kb == 0 { __kb = __alloc(64) }",
        "    let n = __syscall(12, __kb, 64)",
        "    if n <= 0 { return \"\" }",
        "    let p = __str_new(n)",
        "    __copy(p + 8, __kb, n)",
        "    return __str(p)",
        "}",
        "",
        "fn mouse_x() -> int { return __syscall(13, 0) }",
        "fn mouse_y() -> int { return __syscall(13, 1) }",
        "fn mouse_down() -> bool { return __syscall(13, 2) != 0 }",
        "",
        "// ---- sound ----",
        "",
        "// a tone: hz (20..20000) for ms milliseconds; returns at once (sleep(ms) to wait for it)",
        "fn beep(hz: int, ms: int) { __syscall(14, hz, ms) }",
        "",
        "// a note's frequency: \"A4\" is 440, \"C4\" middle C, \"F#3\", \"Bb5\"; 0 for anything else (a rest)",
        "fn note(name: str) -> int {",
        "    let n = __ld(__int(name))",
        "    if n < 2 { return 0 }",
        "    let letter = __ld8(__int(name) + 8)",
        "    var semis = 0",
        "    if letter == 67 { semis = -9 }",
        "    else if letter == 68 { semis = -7 }",
        "    else if letter == 69 { semis = -5 }",
        "    else if letter == 70 { semis = -4 }",
        "    else if letter == 71 { semis = -2 }",
        "    else if letter == 65 { semis = 0 }",
        "    else if letter == 66 { semis = 2 }",
        "    else { return 0 }",
        "    var i = 1",
        "    let c = __ld8(__int(name) + 9)",
        "    if c == 35 {",
        "        semis += 1",
        "        i = 2",
        "    } else if c == 98 {",
        "        semis -= 1",
        "        i = 2",
        "    }",
        "    let octave = parse_int(__sub(name, i, n))",
        "    semis += (octave - 4) * 12",
        "    // 440 * 2^(semis/12), in integers: a table for one octave, then shifts",
        "    let table = [440, 466, 494, 523, 554, 587, 622, 659, 698, 740, 784, 831]",
        "    var oct = 0",
        "    while semis < 0 {",
        "        semis += 12",
        "        oct -= 1",
        "    }",
        "    while semis >= 12 {",
        "        semis -= 12",
        "        oct += 1",
        "    }",
        "    var hz = table[semis]",
        "    while oct > 0 {",
        "        hz = hz * 2",
        "        oct -= 1",
        "    }",
        "    while oct < 0 {",
        "        hz = hz / 2",
        "        oct += 1",
        "    }",
        "    return hz",
        "}",
        "",
    ]
    return ls.join("\n")
}

// the example programs: [file name, source]
fn programs() -> [[str]] {
    var all: [[str]] = []
    all.push(["bounce.st", [
        "// Balls bouncing around a window. Click to add one, arrow keys push them all,",
        "// Space clears. Graphics: window(), clear(), circle(), text(), show().",
        "",
        "struct Ball {",
        "    x: int,",
        "    y: int,",
        "    dx: int,",
        "    dy: int,",
        "    r: int,",
        "    color: int,",
        "}",
        "",
        "const W = 480",
        "const H = 360",
        "",
        "fn ball(x: int, y: int) -> Ball {",
        "    let colors = [0xff6b6b, 0xfeca57, 0x48dbfb, 0x1dd1a1, 0xff9ff3, 0x54a0ff]",
        "    return Ball { x: x * 16, y: y * 16, dx: random(9) - 4 + 1, dy: random(9) - 4 - 1, r: 8 + random(14), color: colors[random(colors.len())] }",
        "}",
        "",
        "fn main() {",
        "    window(W, H, \"Bounce\")",
        "    var balls: [Ball] = []",
        "    for i in 0..5 { balls.push(ball(W / 2, H / 2)) }",
        "    var was_down = false",
        "    var frames = 0",
        "    while true {",
        "        let k = key()",
        "        if k == \" \" { balls.clear() }",
        "        for b in balls {",
        "            if k == \"ArrowLeft\" { b.dx -= 2 }",
        "            if k == \"ArrowRight\" { b.dx += 2 }",
        "            if k == \"ArrowUp\" { b.dy -= 2 }",
        "            if k == \"ArrowDown\" { b.dy += 2 }",
        "        }",
        "        if mouse_down() && !was_down { balls.push(ball(mouse_x(), mouse_y())) }",
        "        was_down = mouse_down()",
        "        clear(0x1e272e)",
        "        for b in balls {",
        "            b.dy += 1",
        "            b.x += b.dx * 4",
        "            b.y += b.dy * 4",
        "            if b.x < b.r * 16 { b.x = b.r * 16; b.dx = abs(b.dx) }",
        "            if b.x > (W - b.r) * 16 { b.x = (W - b.r) * 16; b.dx = -abs(b.dx) }",
        "            if b.y > (H - b.r) * 16 {",
        "                b.y = (H - b.r) * 16",
        "                b.dy = -abs(b.dy) + 1",
        "            }",
        "            circle(b.x / 16, b.y / 16, b.r, b.color)",
        "        }",
        "        text(10, 8, \"\${balls.len()} balls · click to add · Space clears\", 0xd2dae2)",
        "        show()",
        "        frames += 1",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["guess.st", [
        "// Guess the number: a game in the console.",
        "",
        "fn main() {",
        "    let secret = random(100) + 1",
        "    println(\"I'm thinking of a number from 1 to 100.\")",
        "    var tries = 0",
        "    while true {",
        "        let answer = input(\"Your guess: \")",
        "        if !is_number(answer) {",
        "            println(\"That's not a number.\")",
        "            continue",
        "        }",
        "        let g = parse_int(answer)",
        "        tries += 1",
        "        if g < secret {",
        "            println(\"Higher!\")",
        "        } else if g > secret {",
        "            println(\"Lower!\")",
        "        } else {",
        "            println(\"Yes! \${secret}, in \${tries} tries.\")",
        "            break",
        "        }",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["hello.st", [
        "// Your first program. Press Run (or F5): it is compiled to RISC-V machine code",
        "// right here and runs as a process of its own.",
        "",
        "fn main() {",
        "    println(\"Hello from a compiled program!\")",
        "    let name = input(\"What's your name? \")",
        "    println(\"Nice to meet you, \${name}.\")",
        "    for i in 1..6 {",
        "        println(\"\${i} squared is \${i * i}\")",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["music.st", [
        "// A little tune through the sound card: beep(hz, ms) plays a tone,",
        "// note(\"A4\") gives a note's frequency.",
        "",
        "fn play(tune: str, ms: int) {",
        "    for n in tune.split(\" \") {",
        "        let hz = note(n)",
        "        if hz > 0 { beep(hz, ms - 20) }",
        "        print(\"\${n} \")",
        "        sleep(ms)",
        "    }",
        "    println(\"\")",
        "}",
        "",
        "fn main() {",
        "    println(\"♪ Ode to Joy\")",
        "    play(\"E4 E4 F4 G4 G4 F4 E4 D4 C4 C4 D4 E4 E4 D4 D4\", 300)",
        "    play(\"E4 E4 F4 G4 G4 F4 E4 D4 C4 C4 D4 E4 D4 C4 C4\", 300)",
        "}",
        "",
    ].join("\n")])
    all.push(["notebook.st", [
        "// Files from a program: keep a list of notes in notes.txt in your home folder.",
        "",
        "fn main() {",
        "    let file = \"notes.txt\"",
        "    var notes = read_file(file).lines()",
        "    println(\"You have \${notes.len()} notes. Type one to add it, or an empty line to stop.\")",
        "    for i, n in notes { println(\"  \${i + 1}. \${n}\") }",
        "    while true {",
        "        let t = input(\"> \")",
        "        if t == \"\" { break }",
        "        notes.push(t)",
        "    }",
        "    if write_file(file, notes.join(\"\\n\") + \"\\n\") {",
        "        println(\"Saved \${notes.len()} notes to \${file}.\")",
        "    } else {",
        "        println(\"Couldn't save \${file}.\")",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["paint.st", [
        "// Draw with the mouse. Number keys pick a color, C clears.",
        "",
        "fn main() {",
        "    window(520, 380, \"Sketch\")",
        "    let colors = [0xffffff, 0xff6b6b, 0xfeca57, 0x1dd1a1, 0x54a0ff, 0xff9ff3]",
        "    var color = 0",
        "    clear(0x2d3436)",
        "    var lx = -1",
        "    var ly = -1",
        "    while true {",
        "        let k = key()",
        "        if k == \"c\" { clear(0x2d3436) }",
        "        if k >= \"1\" && k <= \"6\" { color = parse_int(k) - 1 }",
        "        if mouse_down() {",
        "            let x = mouse_x()",
        "            let y = mouse_y()",
        "            if lx >= 0 { line(lx, ly, x, y, colors[color]) }",
        "            circle(x, y, 2, colors[color])",
        "            lx = x",
        "            ly = y",
        "        } else {",
        "            lx = -1",
        "        }",
        "        rect(0, 0, 520, 24, 0x1e272e)",
        "        for i in 0..colors.len() {",
        "            rect(8 + i * 26, 4, 18, 16, colors[i])",
        "            if i == color { rect(8 + i * 26, 21, 18, 2, 0xffffff) }",
        "        }",
        "        text(180, 4, \"keys 1-6: colors · C: clear\", 0xb2bec3)",
        "        show()",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["primes.st", [
        "// The primes below 100000 (a sieve), and how long that took.",
        "",
        "fn main() {",
        "    let n = 100000",
        "    let start = now_ms()",
        "    var sieve: [bool] = []",
        "    for i in 0..n { sieve.push(true) }",
        "    var primes: [int] = []",
        "    for i in 2..n {",
        "        if sieve[i] {",
        "            primes.push(i)",
        "            var j = i * i",
        "            while j < n {",
        "                sieve[j] = false",
        "                j += i",
        "            }",
        "        }",
        "    }",
        "    println(\"\${primes.len()} primes below \${n}, found in \${now_ms() - start} ms\")",
        "    println(\"the last ten: \${primes.slice(primes.len() - 10, primes.len())}\")",
        "}",
        "",
    ].join("\n")])
    return all
}
