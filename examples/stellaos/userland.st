        "    var semis = 0",
        "    if letter == 67 { semis = -9 }",
        "    else if letter == 68 { semis = -7 }",
        "    else if letter == 69 { semis = -5 }",
        "    else if letter == 70 { semis = -4 }",
        "    else if letter == 71 { semis = -2 }",
        "    else if letter == 65 { semis = 0 }",
        "    else if letter == 66 { semis = 2 }",
        "    else { return 0 }",
