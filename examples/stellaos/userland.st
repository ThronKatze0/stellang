        "",
        "fn tan(x: float) -> float { return sin(x) / cos(x) }",
        "",
        "// atan: small arguments by the series, the rest by identities",
        "fn atan(x: float) -> float {",
        "    if x < 0.0 { return -atan(-x) }",
        "    if x > 1.0 { return PI / 2.0 - atan(1.0 / x) }",
        "    if x > 0.2679491924311227 {",
        "        // atan(x) = pi/6 + atan((x*sqrt3 - 1) / (x + sqrt3))",
        "        let s3 = 1.7320508075688772",
        "        return PI / 6.0 + atan((x * s3 - 1.0) / (x + s3))",
        "    }",
        "    let x2 = x * x",
        "    var term = x",
        "    var sum = x",
        "    var k = 1",
        "    while k < 30 {",
        "        term = -term * x2",
        "        sum = sum + term / float(2 * k + 1)",
        "        k += 1",
        "    }",
        "    return sum",
        "}",
        "",
        "fn atan2(y: float, x: float) -> float {",
        "    if x > 0.0 { return atan(y / x) }",
        "    if x < 0.0 {",
        "        if y >= 0.0 { return atan(y / x) + PI }",
        "        return atan(y / x) - PI",
        "    }",
        "    if y > 0.0 { return PI / 2.0 }",
        "    if y < 0.0 { return -PI / 2.0 }",
        "    return 0.0",
        "}",
        "",
        "// e^x: 2^k e^r with |r| <= ln2/2",
        "fn exp(x: float) -> float {",
        "    if x > 709.0 { return 1.0 / 0.0 }",
        "    if x < -745.0 { return 0.0 }",
        "    let ln2 = 0.6931471805599453",
        "    let k = (x / ln2).round()",
        "    let r = x - k * ln2",
        "    var term = 1.0",
        "    var sum = 1.0",
        "    var i = 1",
        "    while i < 20 {",
        "        term = term * r / float(i)",
        "        sum = sum + term",
        "        i += 1",
        "    }",
        "    // times 2^k, through the exponent bits",
        "    let ki = int(k)",
        "    if ki > 1000 || ki < -1000 { return sum * __pow2(ki) }",
        "    return sum * __float((ki + 1023) << 52)",
        "}",
        "",
        "fn __pow2(k: int) -> float {",
        "    var p = 1.0",
        "    var n = k",
        "    while n > 0 {",
        "        p = p * 2.0",
        "        n -= 1",
        "    }",
        "    while n < 0 {",
        "        p = p / 2.0",
        "        n += 1",
        "    }",
        "    return p",
        "}",
        "",
        "// the natural logarithm: x = m 2^e, ln m by atanh's series",
        "fn log(x: float) -> float {",
        "    if x <= 0.0 {",
        "        if x == 0.0 { return -1.0 / 0.0 }",
        "        return 0.0 / 0.0",
        "    }",
        "    let bits = __int(x)",
        "    var e = ((bits >> 52) & 2047) - 1023",
        "    var m = __float((bits & 4503599627370495) | 4607182418800017408)   // the mantissa, in [1, 2)",
        "    if e == -1023 {",
        "        // a tiny (subnormal) number",
        "        return log(x * 4503599627370496.0) - 36.04365338911715",
        "    }",
        "    if m > 1.4142135623730951 {",
        "        m = m / 2.0",
        "        e += 1",
        "    }",
        "    let t = (m - 1.0) / (m + 1.0)",
        "    let t2 = t * t",
        "    var term = t",
        "    var sum = 0.0",
        "    var k = 1",
        "    while k < 40 {",
        "        sum = sum + term / float(k)",
        "        term = term * t2",
        "        k += 2",
        "    }",
        "    return 2.0 * sum + float(e) * 0.6931471805599453",
        "}",
        "",
        "fn pow(x: float, y: float) -> float {",
        "    if y == 0.0 { return 1.0 }",
        "    // whole powers: by squaring (exact where it can be, negative bases too)",
        "    if y == y.floor() && y.abs() < 1000000.0 {",
        "        var n = int(y.abs())",
        "        var p = 1.0",
        "        var b = x",
        "        while n > 0 {",
        "            if n % 2 == 1 { p = p * b }",
        "            b = b * b",
        "            n = n / 2",
        "        }",
        "        if y < 0.0 { return 1.0 / p }",
        "        return p",
        "    }",
        "    if x < 0.0 { return 0.0 / 0.0 }",
        "    return exp(y * log(x))",
        "}",
        "",
    ]
    return ls.join("\n")
}

// the example programs: [file name, source]
fn programs() -> [[str]] {
    var all: [[str]] = []
    all.push(["bounce.st", [
        "// Balls bouncing around a window. Click to add one, arrow keys push them all,",
        "// Space clears. Graphics: window(), clear(), circle(), text(), show().",
        "",
        "struct Ball {",
        "    x: int,",
        "    y: int,",
        "    dx: int,",
        "    dy: int,",
        "    r: int,",
        "    color: int,",
        "}",
        "",
        "const W = 480",
        "const H = 360",
        "",
        "fn ball(x: int, y: int) -> Ball {",
        "    let colors = [0xff6b6b, 0xfeca57, 0x48dbfb, 0x1dd1a1, 0xff9ff3, 0x54a0ff]",
        "    return Ball { x: x * 16, y: y * 16, dx: random(9) - 4 + 1, dy: random(9) - 4 - 1, r: 8 + random(14), color: colors[random(colors.len())] }",
        "}",
        "",
        "fn main() {",
        "    window(W, H, \"Bounce\")",
        "    var balls: [Ball] = []",
        "    for i in 0..5 { balls.push(ball(W / 2, H / 2)) }",
        "    var was_down = false",
        "    var frames = 0",
        "    while true {",
        "        let k = key()",
        "        if k == \" \" { balls.clear() }",
        "        for b in balls {",
        "            if k == \"ArrowLeft\" { b.dx -= 2 }",
        "            if k == \"ArrowRight\" { b.dx += 2 }",
        "            if k == \"ArrowUp\" { b.dy -= 2 }",
        "            if k == \"ArrowDown\" { b.dy += 2 }",
        "        }",
        "        if mouse_down() && !was_down { balls.push(ball(mouse_x(), mouse_y())) }",
        "        was_down = mouse_down()",
        "        clear(0x1e272e)",
        "        for b in balls {",
        "            b.dy += 1",
        "            b.x += b.dx * 4",
        "            b.y += b.dy * 4",
        "            if b.x < b.r * 16 { b.x = b.r * 16; b.dx = abs(b.dx) }",
        "            if b.x > (W - b.r) * 16 { b.x = (W - b.r) * 16; b.dx = -abs(b.dx) }",
        "            if b.y > (H - b.r) * 16 {",
        "                b.y = (H - b.r) * 16",
        "                b.dy = -abs(b.dy) + 1",
        "            }",
        "            circle(b.x / 16, b.y / 16, b.r, b.color)",
        "        }",
        "        text(10, 8, \"\${balls.len()} balls · click to add · Space clears\", 0xd2dae2)",
        "        show()",
        "        frames += 1",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["guess.st", [
        "// Guess the number: a game in the console.",
        "",
        "fn main() {",
        "    let secret = random(100) + 1",
        "    println(\"I'm thinking of a number from 1 to 100.\")",
        "    var tries = 0",
        "    while true {",
        "        let answer = input(\"Your guess: \")",
        "        if !is_number(answer) {",
        "            println(\"That's not a number.\")",
        "            continue",
        "        }",
        "        let g = parse_int(answer)",
        "        tries += 1",
        "        if g < secret {",
        "            println(\"Higher!\")",
        "        } else if g > secret {",
        "            println(\"Lower!\")",
        "        } else {",
        "            println(\"Yes! \${secret}, in \${tries} tries.\")",
        "            break",
        "        }",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["hello.st", [
        "// Your first program. Press Run (or F5): it is compiled to RISC-V machine code",
        "// right here and runs as a process of its own.",
        "",
        "fn main() {",
        "    println(\"Hello from a compiled program!\")",
        "    let name = input(\"What's your name? \")",
        "    println(\"Nice to meet you, \${name}.\")",
        "    for i in 1..6 {",
        "        println(\"\${i} squared is \${i * i}\")",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["music.st", [
        "// A little tune through the sound card: beep(hz, ms) plays a tone,",
        "// note(\"A4\") gives a note's frequency.",
        "",
        "fn play(tune: str, ms: int) {",
        "    for n in tune.split(\" \") {",
        "        let hz = note(n)",
        "        if hz > 0 { beep(hz, ms - 20) }",
        "        print(\"\${n} \")",
        "        sleep(ms)",
        "    }",
        "    println(\"\")",
        "}",
        "",
        "fn main() {",
        "    println(\"♪ Ode to Joy\")",
        "    play(\"E4 E4 F4 G4 G4 F4 E4 D4 C4 C4 D4 E4 E4 D4 D4\", 300)",
        "    play(\"E4 E4 F4 G4 G4 F4 E4 D4 C4 C4 D4 E4 D4 C4 C4\", 300)",
        "}",
        "",
    ].join("\n")])
    all.push(["notebook.st", [
        "// Files from a program: keep a list of notes in notes.txt in your home folder.",
        "",
        "fn main() {",
        "    let file = \"notes.txt\"",
        "    var notes = read_file(file).lines()",
        "    println(\"You have \${notes.len()} notes. Type one to add it, or an empty line to stop.\")",
        "    for i, n in notes { println(\"  \${i + 1}. \${n}\") }",
        "    while true {",
        "        let t = input(\"> \")",
        "        if t == \"\" { break }",
        "        notes.push(t)",
        "    }",
        "    if write_file(file, notes.join(\"\\n\") + \"\\n\") {",
        "        println(\"Saved \${notes.len()} notes to \${file}.\")",
        "    } else {",
        "        println(\"Couldn't save \${file}.\")",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["orbits.st", [
        "// Planets going round a sun: floats, sin() and cos(). Up/Down change the speed.",
        "",
        "struct Planet {",
        "    r: float,          // distance from the sun",
        "    speed: float,      // radians per frame",
        "    size: int,",
        "    color: int,",
        "    angle: float = 0.0,",
        "}",
        "",
        "fn main() {",
        "    let w = 520",
        "    let h = 420",
        "    window(w, h, \"Orbits\")",
        "    let cx = float(w / 2)",
        "    let cy = float(h / 2)",
        "    let planets = [",
        "        Planet { r: 50.0, speed: 0.047, size: 5, color: 0xb2bec3 },",
        "        Planet { r: 80.0, speed: 0.035, size: 8, color: 0xfdcb6e },",
        "        Planet { r: 115.0, speed: 0.029, size: 9, color: 0x0984e3 },",
        "        Planet { r: 150.0, speed: 0.024, size: 7, color: 0xe17055 },",
        "        Planet { r: 190.0, speed: 0.013, size: 16, color: 0xe1b382 },",
        "    ]",
        "    var stars: [int] = []",
        "    for i in 0..80 { stars.push(random(w * h)) }",
        "    var warp = 1.0",
        "    var t = 0",
        "    while true {",
        "        let k = key()",
        "        if k == \"ArrowUp\" { warp = warp * 1.5 }",
        "        if k == \"ArrowDown\" { warp = warp / 1.5 }",
        "        clear(0x0c0b1d)",
        "        for s in stars { rect(s % w, s / w, 1, 1, 0x8e8aa8) }",
        "        // the sun, glowing",
        "        circle(int(cx), int(cy), 26, 0xff9f1a)",
        "        circle(int(cx), int(cy), 20, 0xffd32a)",
        "        for p in planets {",
        "            p.angle += p.speed * warp",
        "            let x = cx + p.r * cos(p.angle)",
        "            let y = cy + p.r * sin(p.angle) * 0.85",
        "            circle(int(x), int(y), p.size, p.color)",
        "        }",
        "        text(10, 8, \"speed x\${(warp * 100.0).round() / 100.0} (up/down)\", 0xd2dae2)",
        "        show()",
        "        t += 1",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["paint.st", [
        "// Draw with the mouse. Number keys pick a color, C clears.",
        "",
        "fn main() {",
        "    window(520, 380, \"Sketch\")",
        "    let colors = [0xffffff, 0xff6b6b, 0xfeca57, 0x1dd1a1, 0x54a0ff, 0xff9ff3]",
        "    var color = 0",
        "    clear(0x2d3436)",
        "    var lx = -1",
        "    var ly = -1",
        "    while true {",
        "        let k = key()",
        "        if k == \"c\" { clear(0x2d3436) }",
        "        if k >= \"1\" && k <= \"6\" { color = parse_int(k) - 1 }",
        "        if mouse_down() {",
        "            let x = mouse_x()",
        "            let y = mouse_y()",
        "            if lx >= 0 { line(lx, ly, x, y, colors[color]) }",
        "            circle(x, y, 2, colors[color])",
        "            lx = x",
        "            ly = y",
        "        } else {",
        "            lx = -1",
        "        }",
        "        rect(0, 0, 520, 24, 0x1e272e)",
        "        for i in 0..colors.len() {",
        "            rect(8 + i * 26, 4, 18, 16, colors[i])",
        "            if i == color { rect(8 + i * 26, 21, 18, 2, 0xffffff) }",
        "        }",
        "        text(180, 4, \"keys 1-6: colors · C: clear\", 0xb2bec3)",
        "        show()",
        "    }",
        "}",
        "",
    ].join("\n")])
    all.push(["primes.st", [
        "// The primes below 100000 (a sieve), and how long that took.",
        "",
        "fn main() {",
        "    let n = 100000",
        "    let start = now_ms()",
        "    var sieve: [bool] = []",
        "    for i in 0..n { sieve.push(true) }",
        "    var primes: [int] = []",
        "    for i in 2..n {",
        "        if sieve[i] {",
        "            primes.push(i)",
        "            var j = i * i",
        "            while j < n {",
        "                sieve[j] = false",
        "                j += i",
        "            }",
        "        }",
        "    }",
        "    println(\"\${primes.len()} primes below \${n}, found in \${now_ms() - start} ms\")",
        "    println(\"the last ten: \${primes.slice(primes.len() - 10, primes.len())}\")",
        "}",
        "",
    ].join("\n")])
    return all
}
